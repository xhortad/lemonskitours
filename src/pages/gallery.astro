---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';

// Feature shots
import mountainVista from '../assets/gallery/mountain-vista.jpg';
import pondSunset from '../assets/gallery/pond-sunset.jpg';

// Moments grid
import rzrBlueTrail from '../assets/gallery/rzr-blue-trail.jpg';
import fallTrail from '../assets/gallery/fall-trail-view.jpg';
import waterfallTall from '../assets/gallery/waterfall-tall.jpg';
import mountainRange from '../assets/gallery/mountain-range.jpg';
import fallOverlook from '../assets/gallery/fall-mountain-overlook.jpg';
import waterfallAutumn from '../assets/gallery/waterfall-autumn.jpg';
import trailSideBuggy from '../assets/gallery/trail-side-buggy.jpg';
import waterfallSummer from '../assets/gallery/waterfall-summer.jpg';

const moments = [
  { img: rzrBlueTrail, alt: 'Blue Polaris RZR side-by-side buggy on a North Country dirt trail', caption: 'Your machine, ready to ride' },
  { img: fallTrail, alt: 'Gravel ATV trail winding through colorful fall forest toward New Hampshire mountains', caption: 'On the trail' },
  { img: waterfallTall, alt: 'Tall waterfall cascading down dark rock, framed by summer forest', caption: 'Waterfall stops' },
  { img: mountainRange, alt: "Layered North Country mountain range under dramatic clouds", caption: 'Ridgelines for miles' },
  { img: fallOverlook, alt: "Wide mountain overlook with fall foliage beneath dramatic clouds", caption: 'Big overlooks' },
  { img: waterfallAutumn, alt: 'Waterfall over rocky ledges surrounded by early-autumn trees', caption: 'Backcountry falls' },
  { img: trailSideBuggy, alt: 'Blue side-by-side buggy parked beside a wooded gravel trail', caption: 'Ready for the backcountry' },
  { img: waterfallSummer, alt: 'Waterfall cascading down a rocky gorge surrounded by green forest', caption: 'Summer runs' },
];
---
<BaseLayout
  title="Gallery | Lemonski Tours — North Country ATV Trails"
  description="See where a Lemonski guided ATV tour takes you: mountain views, backcountry trails, waterfalls, and fall color across New Hampshire's North Country."
  image="/files/north-country-atv-hero.png"
>
  <section class="page-head section">
    <p class="eyebrow">On the trail</p>
    <h1 class="page-title">This is where the ride takes you.</h1>
  </section>

  <section class="trail-gallery section" aria-labelledby="trail-gallery-title">
    <div class="trail-gallery-copy">
      <h2 id="trail-gallery-title">Mountain views in every direction.</h2>
      <p>Winding backcountry trails, big overlooks, waterfalls, and North Country color beyond the pavement. Come see what a guided day out looks like.</p>
    </div>
    <figure class="trail-photo trail-photo-main">
      <Image src={mountainVista} alt="North Country mountains in early fall color seen from a gravel trail" />
    </figure>
    <figure class="trail-photo trail-photo-wide">
      <Image src={pondSunset} alt="Backcountry beaver pond reflecting a pastel sunset sky, ringed by pines" />
    </figure>
  </section>

  <section class="trail-moments section" aria-labelledby="trail-moments-title">
    <div class="section-heading trail-moments-heading">
      <p class="eyebrow">Along the way</p>
      <h2 id="trail-moments-title">The stops are part of the story.</h2>
      <p>Waterfalls, backcountry roads, and the moments in between — every ride brings something worth stopping for.</p>
    </div>
    <div class="trail-moments-grid">
      {moments.map((m) => (
        <figure class="moment moment-photo">
          <Image src={m.img} alt={m.alt} />
          <figcaption>{m.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>

  <section class="section page-cta-band">
    <div class="page-cta">
      <a class="button button-primary" href="/book">Add a guided tour <span aria-hidden="true">→</span></a>
    </div>
  </section>
</BaseLayout>
